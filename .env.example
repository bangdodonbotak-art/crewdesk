# CrewDesk — copy to .env.local. NEVER commit real secrets.
# Supabase project: CREATED (crewdesk, ref nizvycrrusghsnefules, ap-southeast-1).
# Get the keys from Supabase dashboard → Settings → API, or the Management API.
NEXT_PUBLIC_SUPABASE_URL=https://nizvycrrusghsnefules.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Inbound forward address (public, shown in Settings):
NEXT_PUBLIC_CREWDESK_INBOUND_ADDRESS=inbox@inbound.crewdesk.example
# Free model for live triage/draft (server-side ONLY, never NEXT_PUBLIC_):
# TokenHarbor DeepSeek free — CREW_MODEL_API_KEY from tokenharbor.ai.
# Without it, triage/draft fall back to a labelled demo fallback.
CREW_MODEL_API_KEY=
# Google OAuth (Supabase Auth provider) — configured in Supabase dashboard,
# not here. Client ID/Secret come from Google Cloud Console (owner-only).
